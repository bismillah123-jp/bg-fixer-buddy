# Contoh environment variables — copy ke .env lalu isi nilainya.
# JANGAN commit file .env ke git!

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Kunci untuk edge function stock-ai (kirim via header x-api-key).
# Harus SAMA dengan STOCK_AI_API_KEY di Supabase Dashboard > Edge Functions > Secrets.
VITE_STOCK_AI_API_KEY=
# (Opsional, untuk referensi) kunci edge function stock-api:
# VITE_STOCK_API_KEY=
